<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    tools:context=".LoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="250dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_welcome" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_gravity="bottom"
                android:scaleType="fitXY"
                android:src="@drawable/curve_mask"
                android:contentDescription="@null" />

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/logo"
                android:contentDescription="@string/logo_desc" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="16dp"
                android:layout_marginTop="90dp"
                android:fontFamily="@font/eb_garamond_medium"
                android:lineSpacingMultiplier="1.0"
                android:text="@string/tagline"
                android:textColor="@color/white"
                android:textSize="34sp" />
        </FrameLayout>

        <!-- Titles -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="32dp"
            android:text="@string/welcome_back"
            android:textColor="@color/primary"
            android:textSize="36sp"
            android:fontFamily="@font/eb_garamond_medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="2dp"
            android:text="@string/login_subtitle"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:fontFamily="@font/eb_garamond_medium" />

        <!-- Username field -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_user"
                android:contentDescription="@null" />

            <EditText
                android:id="@+id/et_username"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:background="@android:color/transparent"
                android:hint="@string/hint_username"
                android:textColorHint="@color/hint"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:letterSpacing="0.03"
                android:inputType="text"
                android:fontFamily="@font/montserrat_semibold" />
        </LinearLayout>

        <!-- Password field -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_lock"
                android:contentDescription="@null" />

            <EditText
                android:id="@+id/et_password"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:background="@android:color/transparent"
                android:hint="@string/hint_password"
                android:textColorHint="@color/hint"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:letterSpacing="0.03"
                android:inputType="textPassword"
                android:fontFamily="@font/montserrat_semibold" />
        </LinearLayout>

        <!-- Remember me / Forgot password -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <CheckBox
                android:id="@+id/check_remember"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:button="@null"
                android:background="@drawable/checkbox_selector"
                android:contentDescription="@string/remember_me" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/remember_me"
                android:textColor="@color/secondary"
                android:textSize="12sp"
                android:letterSpacing="0.05"
                android:fontFamily="@font/montserrat_semibold" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/link_forgot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/forgot_password"
                android:textColor="@color/secondary"
                android:textSize="12sp"
                android:letterSpacing="0.05"
                android:fontFamily="@font/montserrat_semibold" />
        </LinearLayout>

        <!-- Validation error message -->
        <TextView
            android:id="@+id/tv_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="6dp"
            android:textColor="@color/error"
            android:textSize="12sp"
            android:letterSpacing="0.02"
            android:fontFamily="@font/montserrat_semibold"
            android:visibility="gone" />

        <!-- Log In button -->
        <TextView
            android:id="@+id/btn_login"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_primary"
            android:gravity="center"
            android:text="@string/log_in"
            android:textColor="@color/on_primary"
            android:textSize="16sp"
            android:letterSpacing="0.05"
            android:fontFamily="@font/montserrat_semibold" />

        <!-- OR divider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:text="@string/or"
                android:textColor="@color/primary"
                android:textSize="18sp"
                android:fontFamily="@font/eb_garamond_medium" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/secondary" />
        </LinearLayout>

        <!-- Continue as Guest -->
        <TextView
            android:id="@+id/btn_guest"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_button_outline"
            android:gravity="center"
            android:text="@string/continue_guest"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:letterSpacing="0.05"
            android:fontFamily="@font/montserrat_semibold" />

        <!-- Sign up prompt -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_account"
                android:textColor="@color/secondary"
                android:textSize="12sp"
                android:letterSpacing="0.03"
                android:fontFamily="@font/montserrat_semibold" />

            <TextView
                android:id="@+id/link_signup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/sign_up"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:letterSpacing="0.03"
                android:fontFamily="@font/montserrat_semibold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="18dp"
            android:text="@string/copyright"
            android:textColor="@color/secondary"
            android:textSize="10sp"
            android:fontFamily="@font/eb_garamond_medium" />

    </LinearLayout>
</ScrollView>
